FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: set this if the API process cannot resolve ffmpeg from PATH.
# Use the FFmpeg bin directory (or the full path to ffmpeg.exe).
# FFMPEG_LOCATION=C:/tools/ffmpeg/bin
# Optional; leave unset to ignore inherited system proxies.
# YTDLP_PROXY=http://127.0.0.1:8080
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_SECONDS=7200
MAX_DOWNLOAD_SECONDS=1800
JOB_TTL_SECONDS=3600
JOB_CLEANUP_INTERVAL_SECONDS=60
API_RATE_LIMIT_REQUESTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60
# Optional; defaults to the operating system temporary directory.
# FROWNLOADER_TEMP_DIR=C:/Temp/frownloader-jobs
